# Copy to laptop/.env (never commit .env)
ANTHROPIC_API_KEY=
# No Anthropic key? Claude runs through OpenRouter instead
OPENROUTER_API_KEY=
SARVAM_API_KEY=
# Only needed if TRANSCRIBE_PROVIDER=openai
OPENAI_API_KEY=

# Optional overrides
# CLAUDE_MODEL=claude-opus-5
# TRANSCRIBE_PROVIDER=sarvam        # or openai
# SARVAM_MODEL=saaras:v3
# SARVAM_MODE=transcribe            # or codemix for Telugu-English mixing
# TRANSCRIBE_MODEL=gpt-4o-transcribe

# Notion (leave empty -> dry-run: actions are returned but not written)
NOTION_TOKEN=
NOTION_TASKS_DB=
NOTION_NOTES_PAGE=

# Comma-separated valid task owners
TEAM_ROSTER=Ravi,Priya,Harika
