# Copy to laptop/.env (never commit .env)
ANTHROPIC_API_KEY=
# No Anthropic key? Claude runs through OpenRouter instead
OPENROUTER_API_KEY=
SARVAM_API_KEY=
# Only needed if TRANSCRIBE_PROVIDER=openai
OPENAI_API_KEY=

# Optional overrides
# CLAUDE_MODEL=claude-opus-5
# TRANSCRIBE_PROVIDER=openrouter    # or sarvam / openai
# OPENROUTER_STT_MODEL=openai/gpt-audio-mini   # or google/gemini-3.8-flash
# SARVAM_MODEL=saaras:v3
# SARVAM_MODE=transcribe            # or codemix for Telugu-English mixing
# TRANSCRIBE_MODEL=gpt-4o-transcribe

# Notion (leave empty -> dry-run: actions are returned but not written)
NOTION_TOKEN=
NOTION_TASKS_DB=
NOTION_NOTES_PAGE=


# vivo Office Kit Notes: token from the Office Kit app. Empty -> skip
VIVO_NOTES_TOKEN=
# VIVO_NOTES_PORT=9200

# Slack Incoming Webhook for the team channel. Empty -> skip
SLACK_WEBHOOK_URL=
